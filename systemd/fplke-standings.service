[Unit]
Description=FPL Kenya bounded standings snapshot
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=codex
Group=codex
WorkingDirectory=/opt/fplke
EnvironmentFile=/opt/fplke/.env
ExecStart=/opt/fplke/.venv/bin/python /opt/fplke/fplke_pipeline.py standings --max-pages 200
